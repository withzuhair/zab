# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://zab:zab_dev_password@localhost:5432/zab?schema=public

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Auth.js / NextAuth callback origin
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Initial admin (used only by the seed script)
SEED_ADMIN_EMAIL=admin@zabshipping.com
SEED_ADMIN_PASSWORD=change-me-immediately

# Email
RESEND_API_KEY=
EMAIL_FROM="ZAB Shipping <no-reply@zabshipping.com>"
ENQUIRY_NOTIFY_TO=admin@zabshipping.com

# Spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Storage
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
# For STORAGE_DRIVER=r2, set all four values; R2_PUBLIC_URL is the public bucket/custom domain base URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
